# Copy to .env and fill in. .env is git-ignored.

# Login for the web UI.
NOMADINBOX_ADMIN_USER=admin
NOMADINBOX_ADMIN_PASSWORD=change-me

# Host port for the web UI. NOMAD uses 8080 (Command Center), 8090 (Kiwix), 8100-8500 and 11434 (apps).
NOMADINBOX_PORT=8150

# Time zone used for times shown in the UI, e.g. America/New_York, Europe/London.
TZ=UTC
