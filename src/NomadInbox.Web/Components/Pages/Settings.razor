@page "/settings"
@* No prerendering: the form only appears once the live connection is up, so Save can never fall back to a plain page post (which the server rejects). *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using NomadInbox.Core.Mail
@using NomadInbox.Core.Content
@inject SettingsService SettingsService
@inject IMailboxReader MailboxReader
@inject MailIngestService Ingest
@inject NomadInbox.Infrastructure.Ai.OllamaClient Ollama
@inject NomadInbox.Infrastructure.Knowledge.INomadKnowledgeBase Nomad
@inject NomadInbox.Infrastructure.Knowledge.KnowledgeSyncService KnowledgeSync
@inject NomadInbox.Infrastructure.Knowledge.KnowledgeTrigger KnowledgeTrigger
@inject NomadInbox.Infrastructure.Images.ImageDescriber ImageDescriber
@inject NomadInbox.Infrastructure.Images.ImageTrigger ImageTrigger
@inject IDbContextFactory<NomadInboxDbContext> DbFactory
@inject NavigationManager Navigation
@inject NomadInbox.Infrastructure.Bundles.BundleImporter Importer
@using NomadInbox.Infrastructure.Ai

<PageTitle>Settings · NOMAD Inbox</PageTitle>

<h1 class="h3 mb-4">Settings</h1>

@if (form is null)
{
    <p class="text-muted">Connecting… If this doesn't go away, reload the page.</p>
    return;
}

<AppearancePicker />

<EditForm EditContext="editContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="() => saveMessage = null">
    <DataAnnotationsValidator />

    <div class="row g-4">
        <div class="col-xl-7">
            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Mode</h2>
                    <InputSelect id="mode" class="form-select mb-2" @bind-Value="form.Mode">
                        <option value="@AppMode.Connected">Connected: next to NOMAD (checks mail, sends to NOMAD's knowledge base)</option>
                        <option value="@AppMode.Collector">Collector: a wired machine without NOMAD (checks mail, exports bundles)</option>
                        <option value="@AppMode.AirGapped">Air-gapped: the NOMAD without internet (imports bundles)</option>
                    </InputSelect>
                    @switch (form.Mode)
                    {
                        case AppMode.Collector:
                            <div class="form-text mb-3">
                                Everything that needs the internet happens here; the results go into bundles (ZIP files) on the <a href="export">Export</a> page,
                                to carry to the air-gapped NOMAD on a USB drive. Nothing is sent to a knowledge base from here.
                                With an AI set up below, links are summarized and images described here; otherwise the air-gapped NOMAD does it.
                            </div>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label" for="collectorName">Collector name</label>
                                    <InputText id="collectorName" class="form-control" @bind-Value="form.CollectorName" />
                                    <ValidationMessage For="() => form.CollectorName" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="autoExport">Bundle every (hours)</label>
                                    <InputNumber id="autoExport" class="form-control" @bind-Value="form.AutoExportHours" />
                                    <ValidationMessage For="() => form.AutoExportHours" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="aiWait">AI wait (hours)</label>
                                    <InputNumber id="aiWait" class="form-control" @bind-Value="form.ExportAiWaitHours" />
                                    <ValidationMessage For="() => form.ExportAiWaitHours" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="bundleSize">Largest bundle (MB)</label>
                                    <InputNumber id="bundleSize" class="form-control" @bind-Value="form.MaxBundleMegabytes" />
                                    <ValidationMessage For="() => form.MaxBundleMegabytes" />
                                </div>
                            </div>
                            <div class="form-text">
                                0 hours = bundles only with <strong>Create bundle now</strong>. An item goes into a bundle once its links, pages and videos
                                are fetched, and, with an AI here, summarized, or after the wait. A bigger export is split into several bundles:
                                up to 4000 MB fits a FAT32 USB drive.
                            </div>
                            break;
                        case AppMode.AirGapped:
                            <div class="form-text mb-2">
                                No mail checks and nothing fetched from the internet: items arrive in bundles on the <a href="import">Import</a> page,
                                are summarized here if the collector had no AI, and go to NOMAD's knowledge base as usual.
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox id="watch" class="form-check-input" @bind-Value="form.WatchImportFolder" />
                                <label class="form-check-label" for="watch">Also import bundles placed in the import folder</label>
                            </div>
                            <div class="form-text">The folder is <code>@Importer.ImportDirectory</code>; see README-SETUP for showing it in NOMAD's File Browser.</div>
                            break;
                    }
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Gmail account (IMAP)</h2>
                    <p class="text-muted small">
                        Use a dedicated Gmail account. Turn on 2-Step Verification, then create an app password at
                        <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">myaccount.google.com/apppasswords</a>.
                        Your normal Google password will not work.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="host">IMAP server</label>
                            <InputText id="host" class="form-control" @bind-Value="form.ImapHost" />
                            <ValidationMessage For="() => form.ImapHost" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="port">Port</label>
                            <InputNumber id="port" class="form-control" @bind-Value="form.ImapPort" />
                            <ValidationMessage For="() => form.ImapPort" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="user">Email address</label>
                            <InputText id="user" class="form-control" @bind-Value="form.Username" autocomplete="off" />
                            <ValidationMessage For="() => form.Username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pass">App password</label>
                            <InputText id="pass" type="password" class="form-control" @bind-Value="form.NewPassword"
                                       autocomplete="new-password"
                                       placeholder="@(hasSavedPassword ? "Saved. Type to replace it" : "16 characters, spaces optional")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="folder">Folder</label>
                            <InputText id="folder" class="form-control" @bind-Value="form.Folder" />
                            <ValidationMessage For="() => form.Folder" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TestAsync" disabled="@testing">
                            @(testing ? "Testing…" : "Test connection")
                        </button>
                        @if (testResult is not null)
                        {
                            <span class="small @(testResult.Success ? "text-success" : "text-danger")">@testResult.Message</span>
                        }
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Polling</h2>
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox id="enabled" class="form-check-input" @bind-Value="form.PollingEnabled" />
                        <label class="form-check-label" for="enabled">Check for new mail automatically</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="interval">Every (minutes)</label>
                            <InputNumber id="interval" class="form-control" @bind-Value="form.PollIntervalMinutes" />
                            <ValidationMessage For="() => form.PollIntervalMinutes" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="since">On first scan, skip mail before</label>
                            <InputDate id="since" class="form-control" @bind-Value="form.ImportSince" />
                            <div class="form-text">Leave empty to scan the whole folder.</div>
                        </div>
                    </div>
                    <div class="mt-3 small">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ResetCursorAsync">Rescan the folder from the start</button>
                        <div class="text-muted">Use this after changing the prefix. Emails already recorded are skipped.</div>
                        @if (resetMessage is not null) { <div class="text-success">@resetMessage</div> }
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">AI summaries (NOMAD's Ollama)</h2>
                    <p class="text-muted small">
                        Web links are fetched and their readable text is extracted either way. Summaries need NOMAD's
                        AI Assistant installed and a model downloaded in the Command Center.
                    </p>
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox id="ai" class="form-check-input" @bind-Value="form.SummariesEnabled" />
                        <label class="form-check-label" for="ai">Summarize web links</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="ollama">Ollama address</label>
                            <InputText id="ollama" class="form-control" @bind-Value="form.OllamaUrl" disabled="@(!form.SummariesEnabled)" />
                            <div class="form-text">NOMAD's Ollama is at <code>http://nomad_ollama:11434</code>.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="ctx">Context size (tokens)</label>
                            <InputNumber id="ctx" class="form-control" @bind-Value="form.OllamaContextTokens" disabled="@(!form.SummariesEnabled)" />
                            <ValidationMessage For="() => form.OllamaContextTokens" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="model">Model</label>
                            <div class="input-group">
                                <InputText id="model" class="form-control" list="ollama-models" @bind-Value="form.OllamaModel"
                                           placeholder="e.g. gemma3:12b" disabled="@(!form.SummariesEnabled)" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="LoadModelsAsync"
                                        disabled="@(!form.SummariesEnabled || loadingModels)">@(loadingModels ? "Loading…" : "Load models")</button>
                            </div>
                            <datalist id="ollama-models">
                                @foreach (var m in models)
                                {
                                    <option value="@m.Name">@m.Name @(m.ParameterSize is null ? "" : $"({m.ParameterSize})")</option>
                                }
                            </datalist>
                            @if (modelsMessage is not null) { <div class="form-text">@modelsMessage</div> }
                        </div>
                        <div class="col-md-5 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary" @onclick="TestAiAsync"
                                    disabled="@(!form.SummariesEnabled || testingAi)">@(testingAi ? "Asking the model…" : "Test the model")</button>
                        </div>
                    </div>
                    @if (aiTestResult is not null)
                    {
                        <div class="small mt-2 @(aiTestOk ? "text-success" : "text-danger")">@aiTestResult</div>
                    }
                    <details class="mt-3">
                        <summary class="small">Summary instructions (advanced)</summary>
                        <InputTextArea class="form-control form-control-sm mt-2 font-monospace" rows="8" @bind-Value="form.SummaryPrompt"
                                       placeholder="@Summarizer.DefaultPrompt" />
                        <div class="form-text">Leave empty to use the built-in instructions shown as the placeholder.</div>
                    </details>

                    <h3 class="h6 mt-4">Image descriptions</h3>
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox id="describe" class="form-check-input" @bind-Value="form.DescribeImages" disabled="@(!form.SummariesEnabled)" />
                        <label class="form-check-label" for="describe">Describe image attachments and images on saved pages</label>
                    </div>
                    <div class="form-text mb-2">
                        The AI writes a caption, the image's type, categories from the ones you use, tags and the text it can read.
                        They go into NOMAD's knowledge base and show on the email's page. JPG, PNG, WebP, GIF and BMP; SVG and HEIC are skipped.
                    </div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="vision">Model for images</label>
                            <div class="input-group">
                                <InputText id="vision" class="form-control" list="ollama-models" @bind-Value="form.VisionModel"
                                           placeholder="@(string.IsNullOrWhiteSpace(form.OllamaModel) ? "the summary model" : $"{form.OllamaModel} (the summary model)")"
                                           disabled="@(!form.SummariesEnabled || !form.DescribeImages)" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="CheckVisionAsync"
                                        disabled="@(!form.SummariesEnabled || !form.DescribeImages || checkingVision)">@(checkingVision ? "Checking…" : "Check")</button>
                            </div>
                            @if (visionMessage is not null) { <div class="form-text @(visionOk ? "text-success" : "text-warning-emphasis")">@visionMessage</div> }
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="perPage">Images per saved page</label>
                            <InputNumber id="perPage" class="form-control" @bind-Value="form.MaxImagesPerPage" disabled="@(!form.SummariesEnabled || !form.DescribeImages)" />
                            <ValidationMessage For="() => form.MaxImagesPerPage" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                        @if (stored.DescribeImagesFrom is not null)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="DescribeExistingAsync"
                                    disabled="@(!form.SummariesEnabled || !form.DescribeImages)">Describe existing images</button>
                        }
                        <span class="small text-muted">@imageCounts</span>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">NOMAD knowledge base</h2>
                    <p class="text-muted small">
                        Summaries (with the full article or transcript), attachments and email notes are added to the
                        knowledge base of NOMAD's AI Assistant, so you can ask about them in NOMAD's chat. Changes and deletions are kept in step.
                    </p>
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox id="kb" class="form-check-input" @bind-Value="form.KnowledgeBaseEnabled" />
                        <label class="form-check-label" for="kb">Send items to NOMAD's knowledge base</label>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="nomadUrl">NOMAD Command Center address</label>
                            <InputText id="nomadUrl" class="form-control" @bind-Value="form.NomadUrl" disabled="@(!form.KnowledgeBaseEnabled)" />
                            <div class="form-text">NOMAD's Command Center is at <code>http://nomad_admin:8080</code>.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="kbDefault">Collection for uncategorized items</label>
                            <InputText id="kbDefault" class="form-control" @bind-Value="form.KnowledgeDefaultCollection" disabled="@(!form.KnowledgeBaseEnabled)" />
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <InputCheckbox id="kbCat" class="form-check-input" @bind-Value="form.KnowledgeCollectionPerCategory" disabled="@(!form.KnowledgeBaseEnabled)" />
                        <label class="form-check-label" for="kbCat">One collection per top-level category (e.g. <code>Survival/Water</code> → <code>survival</code>)</label>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <InputCheckbox id="kbFull" class="form-check-input" @bind-Value="form.KnowledgeIncludeFullText" disabled="@(!form.KnowledgeBaseEnabled)" />
                        <label class="form-check-label" for="kbFull">Include the full article or transcript, not just the summary (better answers)</label>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="publicUrl">NOMAD Inbox address, for links</label>
                        <InputText id="publicUrl" class="form-control" @bind-Value="form.PublicBaseUrl" placeholder="@Navigation.BaseUri.TrimEnd('/')"
                                   disabled="@(!form.KnowledgeBaseEnabled)" />
                        <ValidationMessage For="() => form.PublicBaseUrl" />
                        <div class="form-text">
                            Documents in NOMAD get links back here (the email, the image, the saved page), which NOMAD's chat can show in its answers.
                            Use the address your browser uses for NOMAD Inbox. Leave empty for no links. Changing it re-sends every document once.
                            @if (prefilledAddress) { <span class="text-warning-emphasis">Filled in from this page's address; click Save settings to use it.</span> }
                        </div>
                    </div>
                    <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="TestNomadAsync"
                                disabled="@(!form.KnowledgeBaseEnabled || testingNomad)">@(testingNomad ? "Checking…" : "Test connection")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResendAllAsync"
                                disabled="@(!form.KnowledgeBaseEnabled)">Resend everything</button>
                        @if (nomadMessage is not null) { <span class="small @(nomadOk ? "text-success" : "text-danger")">@nomadMessage</span> }
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Saved pages</h2>
                    <p class="text-muted small">
                        A local copy of a web page's main content (text with its formatting, images and videos), with its links recorded.
                        Read them in the <a href="library">Library</a>; a plain-HTML copy goes to NOMAD's File Browser folder.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="pgMode">Save web links</label>
                            <InputSelect id="pgMode" class="form-select" @bind-Value="form.PageArchiveMode">
                                <option value="@PageArchiveMode.Never">Never (only with Save page)</option>
                                <option value="@PageArchiveMode.Tagged">Only for emails tagged #archive</option>
                                <option value="@PageArchiveMode.Always">Always</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pgLinked">"Save linked pages" saves at most</label>
                            <InputNumber id="pgLinked" class="form-control" @bind-Value="form.SaveLinkedPagesLimit" />
                            <ValidationMessage For="() => form.SaveLinkedPagesLimit" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pgMax">Max size per page, with media (MB)</label>
                            <InputNumber id="pgMax" class="form-control" @bind-Value="form.MaxPageMegabytes" />
                            <ValidationMessage For="() => form.MaxPageMegabytes" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="pgAsset">Max size per image or video (MB)</label>
                            <InputNumber id="pgAsset" class="form-control" @bind-Value="form.MaxPageAssetMegabytes" />
                            <ValidationMessage For="() => form.MaxPageAssetMegabytes" />
                        </div>
                    </div>
                    <div class="form-text mt-2">
                        YouTube videos embedded in a saved page are added to the email, so they follow the YouTube settings below.
                    </div>
                    <a class="btn btn-outline-secondary btn-sm mt-3" href="settings/page-template">Edit the page template</a>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">YouTube</h2>
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label" for="langs">Transcript languages</label>
                            <InputText id="langs" class="form-control" @bind-Value="form.TranscriptLanguages" placeholder="en" />
                            <div class="form-text">Preferred caption languages, most preferred first (e.g. <code>en, de</code>). The video's original-language captions are used when none match.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="followHours">Check followed channels every (hours)</label>
                            <InputNumber id="followHours" class="form-control" @bind-Value="form.FollowCheckHours" />
                            <ValidationMessage For="() => form.FollowCheckHours" />
                        </div>
                    </div>
                    <h3 class="h6 mt-4">Save videos for offline viewing</h3>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label" for="dlMode">Download videos</label>
                            <InputSelect id="dlMode" class="form-select" @bind-Value="form.VideoDownloadMode">
                                <option value="@VideoDownloadMode.Never">Never</option>
                                <option value="@VideoDownloadMode.Tagged">Only for emails tagged #download</option>
                                <option value="@VideoDownloadMode.Always">Always</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="dlHeight">Max quality</label>
                            <InputSelect id="dlHeight" class="form-select" @bind-Value="form.MaxVideoHeight">
                                <option value="360">360p</option>
                                <option value="480">480p</option>
                                <option value="720">720p</option>
                                <option value="1080">1080p</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="dlSize">Max size per video (MB)</label>
                            <InputNumber id="dlSize" class="form-control" @bind-Value="form.MaxVideoMegabytes" />
                            <ValidationMessage For="() => form.MaxVideoMegabytes" />
                        </div>
                    </div>
                    <div class="form-text">
                        Videos go to NOMAD's shared media folder (<code>media/youtube</code>), so Jellyfin and File Browser can see them.
                        Roughly 10–20 MB per minute at 720p. A channel followed from a <code>#download</code> email downloads its new videos too.
                    </div>

                    <div class="form-text mt-3">
                        yt-dlp @(NomadInbox.Infrastructure.YouTube.YtDlpMaintenance.Version ?? "(version not known yet)"); it updates itself daily.
                        Manage followed channels on the <a href="channels">Channels</a> page.
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Filtering</h2>
                    <div class="mb-3">
                        <label class="form-label" for="prefix">Subject prefix</label>
                        <InputText id="prefix" class="form-control" @bind-Value="form.SubjectPrefix" />
                        <ValidationMessage For="() => form.SubjectPrefix" />
                    </div>
                    <div>
                        <label class="form-label" for="senders">Allowed senders</label>
                        <InputTextArea id="senders" class="form-control font-monospace" rows="4" @bind-Value="form.AllowedSenders"
                                       placeholder="@SendersPlaceholder" />
                        <div class="form-text">
                            One address or <code>@@domain</code> per line. Mail from anyone else is recorded as <em>Ignored</em> and never processed.
                            @if (string.IsNullOrWhiteSpace(form.AllowedSenders))
                            {
                                <span class="text-warning-emphasis">Empty means anyone who knows the address can submit content.</span>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Attachments</h2>
                    <p class="text-muted small">Files of a kind that's off, or bigger than the limit, are listed on the email but not saved.</p>
                    @foreach (var (kind, label, hint) in AttachmentKindOptions)
                    {
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="kind-@kind" checked="@form.AllowedAttachmentKinds.HasFlag(kind)"
                                   @onchange="e => SetAttachmentKind(kind, e.Value is true)" />
                            <label class="form-check-label" for="kind-@kind">@label</label>
                            <div class="form-text mt-0 mb-2">@hint</div>
                        </div>
                    }
                    @if (form.AllowedAttachmentKinds.HasFlag(AttachmentKinds.Executables))
                    {
                        <div class="form-text mb-2">Programs and scripts are saved inside a zip (<code>setup.exe.zip</code>), so opening one can't run it.</div>
                        @if (string.IsNullOrWhiteSpace(form.AllowedSenders))
                        {
                            <div class="alert alert-warning small py-2" role="alert">
                                <strong>Allowed senders is empty.</strong> Anyone who knows the Gmail address can send programs that get saved here.
                                Add your own address under Filtering, or turn programs and scripts off.
                            </div>
                        }
                    }
                    <label class="form-label mt-2" for="maxMb">Largest attachment to store (MB)</label>
                    <InputNumber id="maxMb" class="form-control" @bind-Value="form.MaxAttachmentMegabytes" />
                    <ValidationMessage For="() => form.MaxAttachmentMegabytes" />
                    <div class="form-text">Bigger files are listed on the email but not saved.</div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Processing</h2>
                    <div class="form-check form-switch mb-2">
                        <InputCheckbox id="labels" class="form-check-input" @bind-Value="form.ApplyLabels" />
                        <label class="form-check-label" for="labels">Label processed mail in Gmail</label>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="okLabel">Processed label</label>
                            <InputText id="okLabel" class="form-control" @bind-Value="form.ProcessedLabel" disabled="@(!form.ApplyLabels)" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="failLabel">Failed label</label>
                            <InputText id="failLabel" class="form-control" @bind-Value="form.FailedLabel" disabled="@(!form.ApplyLabels)" />
                        </div>
                    </div>
                    <div class="form-text mb-3">Gmail creates the labels on first use. A <code>/</code> nests them, so both appear under "NOMAD".</div>
                    <div class="form-check form-switch">
                        <InputCheckbox id="private" class="form-check-input" @bind-Value="form.AllowPrivateNetworkLinks" />
                        <label class="form-check-label" for="private">Allow links to local-network addresses</label>
                    </div>
                    <div class="form-text">Off by default, so an emailed link can't make NOMAD Inbox read pages from your own network (NOMAD itself, your router, …).</div>
                    <div class="form-check form-switch mt-3">
                        <InputCheckbox id="render" class="form-check-input" @bind-Value="form.RenderJavaScriptPages" />
                        <label class="form-check-label" for="render">Render JavaScript pages in a headless browser</label>
                    </div>
                    <div class="form-text">Used only when a page has almost no text without JavaScript (single-page and WebAssembly apps). Slower, up to about a minute per page.</div>
                </div>
            </section>

            <section class="card mb-4">
                <div class="card-body">
                    <h2 class="h5">Subject syntax</h2>
                    <p class="small text-muted mb-2">
                        <code>@form.SubjectPrefix Category/Sub #tag key=value Title words</code>. A single-level category needs a trailing slash (<code>Survival/</code>) or <code>cat=Survival</code>; quote names with spaces (<code>"Medical/First Aid"</code>).
                    </p>
                    <input class="form-control form-control-sm mb-2" @bind="sample" @bind:event="oninput" />
                    @if (SubjectParser.Parse(sample, form.SubjectPrefix) is { } parsed)
                    {
                        <dl class="row small mb-0">
                            <dt class="col-4">Category</dt><dd class="col-8">@(parsed.Category ?? "—")</dd>
                            <dt class="col-4">Tags</dt><dd class="col-8">@(parsed.Tags.Count == 0 ? "—" : string.Join(", ", parsed.Tags))</dd>
                            <dt class="col-4">Fields</dt><dd class="col-8">@(parsed.Fields.Count == 0 ? "—" : string.Join(", ", parsed.Fields.Select(kv => $"{kv.Key}={kv.Value}")))</dd>
                            <dt class="col-4">Title</dt><dd class="col-8">@(parsed.Title.Length == 0 ? "—" : parsed.Title)</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="small text-danger mb-0">Doesn't start with the prefix, so it would be skipped.</p>
                    }
                </div>
            </section>
        </div>
    </div>

    <ValidationSummary class="text-danger small mb-2" />
    <div class="save-bar d-flex align-items-center gap-3 mb-4">
        <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Saving…" : "Save settings")</button>
        @if (dirty) { <span class="text-warning-emphasis fw-semibold">Unsaved changes. Nothing takes effect until you save.</span> }
        else if (saveMessage is not null) { <span class="text-success">@saveMessage</span> }
    </div>
</EditForm>

@code {
    private const string SendersPlaceholder = "you@gmail.com\n@yourfamily.org";

    private InboxSettings stored = new();
    private SettingsForm? form;
    private EditContext? editContext;
    private bool dirty;
    private bool hasSavedPassword;
    private bool testing, saving;
    private ConnectionTestResult? testResult;
    private string? saveMessage, resetMessage;
    private string sample = "NOMAD: Survival/Water #filtration #diy priority=high Ceramic filter builds";
    private bool testingNomad, nomadOk;
    private string? nomadMessage;

    private async Task TestNomadAsync()
    {
        testingNomad = true;
        nomadMessage = null;
        try
        {
            var url = form!.NomadUrl ?? "";
            if (!await Nomad.IsAvailableAsync(url, CancellationToken.None))
                throw new NomadInbox.Infrastructure.Knowledge.NomadException(
                    $"No knowledge base answering at {url}. Is NOMAD's AI Assistant installed?");
            var files = await Nomad.ListFilesAsync(url, CancellationToken.None);
            nomadOk = true;
            nomadMessage = $"Connected. NOMAD's knowledge base holds {files.Count} file(s).";
        }
        catch (NomadInbox.Infrastructure.Knowledge.NomadException ex)
        {
            nomadOk = false;
            nomadMessage = ex.Message;
        }
        finally
        {
            testingNomad = false;
        }
    }

    private async Task ResendAllAsync()
    {
        var count = await KnowledgeSync.ResendAllAsync(CancellationToken.None);
        KnowledgeTrigger.Signal();
        nomadOk = true;
        nomadMessage = count == 0
            ? "Nothing sent yet; items go out on the next sync."
            : $"{count} document(s) will be sent again over the next few minutes (10 at a time).";
    }

    private IReadOnlyList<OllamaModel> models = [];
    private bool loadingModels, testingAi, aiTestOk;
    private string? modelsMessage, aiTestResult;

    private async Task LoadModelsAsync()
    {
        loadingModels = true;
        modelsMessage = null;
        try
        {
            models = await Ollama.ListModelsAsync(form!.OllamaUrl ?? "", CancellationToken.None);
            modelsMessage = models.Count == 0
                ? "Ollama is running but has no models yet. Download one in NOMAD's AI Assistant settings."
                : $"{models.Count} model(s) installed: {string.Join(", ", models.Select(m => m.Name))}";
        }
        catch (OllamaException ex)
        {
            models = [];
            modelsMessage = ex.Message + " Is NOMAD's AI Assistant installed?";
        }
        finally
        {
            loadingModels = false;
        }
    }

    private async Task TestAiAsync()
    {
        testingAi = true;
        aiTestResult = null;
        var started = DateTime.UtcNow;
        try
        {
            if (string.IsNullOrWhiteSpace(form!.OllamaModel))
                throw new OllamaException("Choose a model first.");
            var reply = await Ollama.ChatAsync(form.OllamaUrl ?? "", form.OllamaModel.Trim(),
                "You are a test. Answer with one short sentence.", "Say that the connection works.",
                Math.Clamp(form.OllamaContextTokens, 2048, 131072), CancellationToken.None);
            aiTestOk = true;
            aiTestResult = $"{form.OllamaModel} answered in {(DateTime.UtcNow - started).TotalSeconds:0.0}s: \"{reply}\"" +
                (dirty ? " Now click Save settings to use it." : "");
        }
        catch (OllamaException ex)
        {
            aiTestOk = false;
            aiTestResult = ex.Message;
        }
        finally
        {
            testingAi = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        stored = await SettingsService.GetAsync();
        form = SettingsForm.From(stored);
        editContext = new EditContext(form);
        // Field edits only re-render the input itself, so refresh the page to show the warning next to Save.
        editContext.OnFieldChanged += (_, _) => { dirty = true; StateHasChanged(); };
        hasSavedPassword = !string.IsNullOrEmpty(stored.ProtectedPassword);
        if (string.IsNullOrWhiteSpace(form.PublicBaseUrl))
        {
            // The address this page was opened with is the one the browser uses for NOMAD Inbox.
            form.PublicBaseUrl = Navigation.BaseUri.TrimEnd('/');
            prefilledAddress = dirty = true;
        }
        await LoadImageCountsAsync();
    }

    private bool prefilledAddress;
    private bool checkingVision, visionOk;
    private string? visionMessage;
    private string imageCounts = "";

    private async Task LoadImageCountsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var counts = await db.ImageDescriptions.GroupBy(d => d.Status).Select(g => new { g.Key, Count = g.Count() }).ToListAsync();
        int Count(ImageDescriptionStatus s) => counts.FirstOrDefault(c => c.Key == s)?.Count ?? 0;
        imageCounts = counts.Count == 0 ? "No images described yet." :
            $"{Count(ImageDescriptionStatus.Done)} described, {Count(ImageDescriptionStatus.Pending)} waiting" +
            (Count(ImageDescriptionStatus.Failed) > 0 ? $", {Count(ImageDescriptionStatus.Failed)} failed" : "") +
            (Count(ImageDescriptionStatus.Skipped) > 0 ? $", {Count(ImageDescriptionStatus.Skipped)} skipped (format)" : "") + ".";
    }

    private async Task CheckVisionAsync()
    {
        checkingVision = true;
        visionMessage = null;
        var model = string.IsNullOrWhiteSpace(form!.VisionModel) ? form.OllamaModel?.Trim() : form.VisionModel.Trim();
        try
        {
            if (string.IsNullOrWhiteSpace(model)) throw new OllamaException("Choose a model first.");
            var capabilities = await Ollama.CapabilitiesAsync(form.OllamaUrl ?? "", model, CancellationToken.None);
            visionOk = capabilities.Contains("vision");
            visionMessage = visionOk
                ? $"{model} can read images."
                : capabilities.Count == 0
                    ? $"Ollama didn't say whether {model} can read images; try it on one."
                    : $"{model} can't read images ({string.Join(", ", capabilities)}). Use a vision model such as gemma3:4b, gemma3:12b or llava.";
        }
        catch (OllamaException ex)
        {
            visionOk = false;
            visionMessage = ex.Message;
        }
        finally
        {
            checkingVision = false;
        }
    }

    private async Task DescribeExistingAsync()
    {
        await ImageDescriber.DescribeExistingAsync(CancellationToken.None);
        stored.DescribeImagesFrom = null;
        ImageTrigger.Signal();
        imageCounts = "Existing images are queued; they're described one at a time over the next minutes.";
    }

    private async Task TestAsync()
    {
        testing = true;
        testResult = null;
        try
        {
            var account = SettingsService.CreateAccount(form!.ApplyTo(await SettingsService.GetAsync()), form.NewPassword);
            testResult = account is null
                ? new ConnectionTestResult(false, "Enter the server, email address and app password first.")
                : await MailboxReader.TestConnectionAsync(account, CancellationToken.None);
        }
        finally
        {
            testing = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        saveMessage = null;
        try
        {
            // Start from what's saved now, so settings this form doesn't show (the saved-page template and stylesheet,
            // or anything changed elsewhere since the page opened) are kept.
            var before = await SettingsService.GetAsync();
            var modeChanged = before.Mode != form!.Mode;
            stored = form.ApplyTo(before);
            await SettingsService.SaveAsync(stored, form.NewPassword);
            hasSavedPassword = !string.IsNullOrEmpty(stored.ProtectedPassword);
            form.NewPassword = null;
            saveMessage = $"Saved at {DateTime.Now:HH:mm:ss}.";
            dirty = false;
            // The menu (Export / Import) follows the mode; it's drawn once per page load.
            if (modeChanged) Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ResetCursorAsync()
    {
        await Ingest.ResetCursorAsync(stored.Folder, CancellationToken.None);
        resetMessage = $"The next check rescans \"{stored.Folder}\".";
    }

    private static readonly (AttachmentKinds Kind, string Label, string Hint)[] AttachmentKindOptions =
    [
        (AttachmentKinds.Images, "Images", "jpg, png, gif, webp, heic, svg, …"),
        (AttachmentKinds.Video, "Videos", "mp4, mkv, mov, webm, …"),
        (AttachmentKinds.Audio, "Audio", "mp3, m4a, wav, ogg, flac, …"),
        (AttachmentKinds.Documents, "Documents and text", "txt, pdf, Word, Excel, PowerPoint, e-books, csv, json, gpx, …"),
        (AttachmentKinds.Archives, "Archives", "zip, 7z, rar, tar, gz, … (a zip with a program inside counts as a program)"),
        (AttachmentKinds.Other, "Other files", "anything else that isn't a program"),
        (AttachmentKinds.Executables, "Programs and scripts", "exe, msi, apk, sh, ps1, bat, py, dmg, iso, macro-enabled Office files, …; recognized by name and by content."),
    ];

    private void SetAttachmentKind(AttachmentKinds kind, bool allowed)
    {
        form!.AllowedAttachmentKinds = allowed ? form.AllowedAttachmentKinds | kind : form.AllowedAttachmentKinds & ~kind;
        editContext!.NotifyFieldChanged(editContext.Field(nameof(SettingsForm.AllowedAttachmentKinds)));
    }

    private sealed class SettingsForm : IValidatableObject
    {
        [Required] public string ImapHost { get; set; } = "";
        [Range(1, 65535)] public int ImapPort { get; set; }
        [Display(Name = "Email address")] public string Username { get; set; } = "";
        public string? NewPassword { get; set; }
        [Required] public string Folder { get; set; } = "";
        [Required, Display(Name = "Subject prefix")] public string SubjectPrefix { get; set; } = "";
        public string? AllowedSenders { get; set; }
        public DateTime? ImportSince { get; set; }
        public bool PollingEnabled { get; set; }
        [Range(1, 1440, ErrorMessage = "Choose between 1 and 1440 minutes.")] public int PollIntervalMinutes { get; set; }
        public bool ApplyLabels { get; set; }
        public string? ProcessedLabel { get; set; }
        public string? FailedLabel { get; set; }
        [Range(1, 1024, ErrorMessage = "Choose between 1 and 1024 MB.")] public int MaxAttachmentMegabytes { get; set; }
        public AttachmentKinds AllowedAttachmentKinds { get; set; }
        public bool AllowPrivateNetworkLinks { get; set; }
        public bool RenderJavaScriptPages { get; set; }
        public string? TranscriptLanguages { get; set; }
        [Range(1, 168, ErrorMessage = "Choose between 1 and 168 hours.")] public int FollowCheckHours { get; set; }
        public VideoDownloadMode VideoDownloadMode { get; set; }
        public int MaxVideoHeight { get; set; }
        [Range(10, 100000, ErrorMessage = "Choose between 10 and 100000 MB.")] public int MaxVideoMegabytes { get; set; }
        public bool KnowledgeBaseEnabled { get; set; }
        public string? NomadUrl { get; set; }
        public bool KnowledgeIncludeFullText { get; set; }
        public bool KnowledgeCollectionPerCategory { get; set; }
        public string? KnowledgeDefaultCollection { get; set; }
        public PageArchiveMode PageArchiveMode { get; set; }
        [Range(1, 10000, ErrorMessage = "Choose between 1 and 10000 MB.")] public int MaxPageMegabytes { get; set; }
        [Range(1, 10000, ErrorMessage = "Choose between 1 and 10000 MB.")] public int MaxPageAssetMegabytes { get; set; }
        [Range(1, 500, ErrorMessage = "Choose between 1 and 500.")] public int SaveLinkedPagesLimit { get; set; }
        public bool SummariesEnabled { get; set; }
        public string? OllamaUrl { get; set; }
        public string? OllamaModel { get; set; }
        [Range(2048, 131072, ErrorMessage = "Choose between 2048 and 131072 tokens.")] public int OllamaContextTokens { get; set; }
        public string? SummaryPrompt { get; set; }
        public bool DescribeImages { get; set; }
        public string? VisionModel { get; set; }
        [Range(0, 100, ErrorMessage = "Choose between 0 and 100.")] public int MaxImagesPerPage { get; set; }
        [Url(ErrorMessage = "Enter a full address, e.g. http://localhost:8601.")] public string? PublicBaseUrl { get; set; }
        public AppMode Mode { get; set; }
        [Required, Display(Name = "Collector name")] public string CollectorName { get; set; } = "";
        [Range(0, 720, ErrorMessage = "Choose between 0 and 720 hours.")] public int AutoExportHours { get; set; }
        [Range(0, 168, ErrorMessage = "Choose between 0 and 168 hours.")] public int ExportAiWaitHours { get; set; }
        [Range(100, 4000, ErrorMessage = "Choose between 100 and 4000 MB.")] public int MaxBundleMegabytes { get; set; }
        public bool WatchImportFolder { get; set; }

        public static SettingsForm From(InboxSettings s) => new()
        {
            AllowPrivateNetworkLinks = s.AllowPrivateNetworkLinks, RenderJavaScriptPages = s.RenderJavaScriptPages,
            TranscriptLanguages = s.TranscriptLanguages, FollowCheckHours = s.FollowCheckHours,
            VideoDownloadMode = s.VideoDownloadMode, MaxVideoHeight = s.MaxVideoHeight, MaxVideoMegabytes = s.MaxVideoMegabytes,
            KnowledgeBaseEnabled = s.KnowledgeBaseEnabled, NomadUrl = s.NomadUrl, KnowledgeIncludeFullText = s.KnowledgeIncludeFullText,
            KnowledgeCollectionPerCategory = s.KnowledgeCollectionPerCategory, KnowledgeDefaultCollection = s.KnowledgeDefaultCollection,
            PageArchiveMode = s.PageArchiveMode, MaxPageMegabytes = s.MaxPageMegabytes, MaxPageAssetMegabytes = s.MaxPageAssetMegabytes,
            SaveLinkedPagesLimit = s.SaveLinkedPagesLimit,
            SummariesEnabled = s.SummariesEnabled,
            OllamaUrl = s.OllamaUrl, OllamaModel = s.OllamaModel, OllamaContextTokens = s.OllamaContextTokens,
            SummaryPrompt = s.SummaryPrompt,
            DescribeImages = s.DescribeImages, VisionModel = s.VisionModel, MaxImagesPerPage = s.MaxImagesPerPage,
            PublicBaseUrl = s.PublicBaseUrl,
            Mode = s.Mode, CollectorName = s.CollectorName, AutoExportHours = s.AutoExportHours, ExportAiWaitHours = s.ExportAiWaitHours,
            MaxBundleMegabytes = s.MaxBundleMegabytes, WatchImportFolder = s.WatchImportFolder,
            ImapHost = s.ImapHost, ImapPort = s.ImapPort, Username = s.Username, Folder = s.Folder,
            SubjectPrefix = s.SubjectPrefix, AllowedSenders = s.AllowedSenders,
            ImportSince = s.ImportSince?.LocalDateTime.Date,
            PollingEnabled = s.PollingEnabled, PollIntervalMinutes = s.PollIntervalMinutes,
            ApplyLabels = s.ApplyLabels, ProcessedLabel = s.ProcessedLabel, FailedLabel = s.FailedLabel,
            MaxAttachmentMegabytes = s.MaxAttachmentMegabytes, AllowedAttachmentKinds = s.AllowedAttachmentKinds,
        };

        // The Gmail address is needed only where mail is checked; the air-gapped NOMAD gets everything in bundles.
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Mode != AppMode.AirGapped && string.IsNullOrWhiteSpace(Username))
                yield return new ValidationResult("The Email address field is required.", [nameof(Username)]);
        }

        public InboxSettings ApplyTo(InboxSettings s)
        {
            s.ImapHost = ImapHost.Trim();
            s.ImapPort = ImapPort;
            s.Username = Username.Trim();
            s.Folder = Folder.Trim();
            s.SubjectPrefix = SubjectPrefix.Trim();
            s.AllowedSenders = AllowedSenders ?? "";
            s.ImportSince = ImportSince is { } d ? new DateTimeOffset(DateTime.SpecifyKind(d.Date, DateTimeKind.Local)) : null;
            s.PollingEnabled = PollingEnabled;
            s.PollIntervalMinutes = PollIntervalMinutes;
            s.ApplyLabels = ApplyLabels;
            s.ProcessedLabel = string.IsNullOrWhiteSpace(ProcessedLabel) ? "NOMAD/Processed" : ProcessedLabel.Trim();
            s.FailedLabel = string.IsNullOrWhiteSpace(FailedLabel) ? "NOMAD/Failed" : FailedLabel.Trim();
            s.MaxAttachmentMegabytes = MaxAttachmentMegabytes;
            s.AllowedAttachmentKinds = AllowedAttachmentKinds;
            s.AllowPrivateNetworkLinks = AllowPrivateNetworkLinks;
            s.RenderJavaScriptPages = RenderJavaScriptPages;
            s.TranscriptLanguages = string.IsNullOrWhiteSpace(TranscriptLanguages) ? "en" : TranscriptLanguages.Trim();
            s.FollowCheckHours = FollowCheckHours;
            s.VideoDownloadMode = VideoDownloadMode;
            s.MaxVideoHeight = MaxVideoHeight;
            s.MaxVideoMegabytes = MaxVideoMegabytes;
            s.KnowledgeBaseEnabled = KnowledgeBaseEnabled;
            s.NomadUrl = string.IsNullOrWhiteSpace(NomadUrl) ? "http://nomad_admin:8080" : NomadUrl.Trim().TrimEnd('/');
            s.KnowledgeIncludeFullText = KnowledgeIncludeFullText;
            s.KnowledgeCollectionPerCategory = KnowledgeCollectionPerCategory;
            s.KnowledgeDefaultCollection = string.IsNullOrWhiteSpace(KnowledgeDefaultCollection) ? "nomad inbox" : KnowledgeDefaultCollection.Trim();
            s.PageArchiveMode = PageArchiveMode;
            s.MaxPageMegabytes = MaxPageMegabytes;
            s.MaxPageAssetMegabytes = MaxPageAssetMegabytes;
            s.SaveLinkedPagesLimit = SaveLinkedPagesLimit;
            s.SummariesEnabled = SummariesEnabled;
            s.OllamaUrl = string.IsNullOrWhiteSpace(OllamaUrl) ? "http://nomad_ollama:11434" : OllamaUrl.Trim().TrimEnd('/');
            s.OllamaModel = OllamaModel?.Trim() ?? "";
            s.OllamaContextTokens = OllamaContextTokens;
            s.SummaryPrompt = string.IsNullOrWhiteSpace(SummaryPrompt) ? null : SummaryPrompt.Trim();
            s.DescribeImages = DescribeImages;
            s.VisionModel = string.IsNullOrWhiteSpace(VisionModel) ? null : VisionModel.Trim();
            s.MaxImagesPerPage = MaxImagesPerPage;
            s.PublicBaseUrl = string.IsNullOrWhiteSpace(PublicBaseUrl) ? null : PublicBaseUrl.Trim().TrimEnd('/');
            s.Mode = Mode;
            s.CollectorName = CollectorName.Trim();
            s.AutoExportHours = AutoExportHours;
            s.ExportAiWaitHours = ExportAiWaitHours;
            s.MaxBundleMegabytes = MaxBundleMegabytes;
            s.WatchImportFolder = WatchImportFolder;
            return s;
        }
    }
}
