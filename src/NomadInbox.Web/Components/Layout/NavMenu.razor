<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">NOMAD Inbox</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="emails">
                <span class="bi bi-envelope-fill-nav-menu" aria-hidden="true"></span> Emails
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="library">
                <span class="bi bi-book-fill-nav-menu" aria-hidden="true"></span> Library
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="channels">
                <span class="bi bi-play-fill-nav-menu" aria-hidden="true"></span> Channels
            </NavLink>
        </div>

        @if (Mode == AppMode.Collector)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="export">
                    <span class="bi bi-box-arrow-up-nav-menu" aria-hidden="true"></span> Export
                </NavLink>
            </div>
        }
        @if (Mode == AppMode.AirGapped)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="import">
                    <span class="bi bi-box-arrow-in-down-nav-menu" aria-hidden="true"></span> Import
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [CascadingParameter(Name = "AppMode")] private AppMode Mode { get; set; }
}
